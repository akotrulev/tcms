# Copy to .env before `docker compose up`. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# These are LOCAL DEVELOPMENT credentials for a disposable container bound to 127.0.0.1.
# They are not secrets and they are not a template for a server: the Hetzner runbook
# generates its own with `openssl rand -base64 32` and keeps them in a root-owned
# environment file, never in a repository.

# Superuser. Used once by initdb to run deploy/postgres/initdb/10-tcms-roles.sql.
# Nothing connects as it afterwards.
POSTGRES_SUPERUSER_PASSWORD=local-superuser

# tcms_owner — owns the schema, used by Flyway only.
DB_MIGRATION_PASSWORD=local-owner

# tcms_app — the application pool. Owns nothing, holds no BYPASSRLS.
DB_PASSWORD=local-app

# Signs session tokens. At least 32 characters — HS256 keys shorter than the hash
# block size are padded rather than strengthened, so a short one only looks fine.
# Generate a real one for anything that is not a laptop: openssl rand -base64 48
TCMS_JWT_SECRET=local-development-signing-key-not-for-any-server

# Encrypts notification-channel credentials at rest. A Slack or Teams webhook URL IS the
# authentication for that room, so this key opens every one of them. Base64 of exactly
# 32 bytes — anything else is refused at startup: openssl rand -base64 32
TCMS_INTEGRATION_SECRET_KEY=bG9jYWwtZGV2ZWxvcG1lbnQta2V5LW5vdC1hLXNydnI=

# Encrypts OIDC client secrets at rest. Separate from the key above because the two live in
# modules that may not see each other, and because losing one should not be losing both.
# Base64 of exactly 32 bytes — anything else is refused at startup: openssl rand -base64 32
TCMS_IDENTITY_SECRET_KEY=bG9jYWwtZGV2LWlkZW50aXR5LWtleS0zMi1ieXRlcyE=

# This API's public origin. An OIDC redirect_uri is built from it, and a client registers that
# exact string with their issuer — so it is the address a browser can reach, not the container's.
TCMS_API_BASE_URL=http://localhost:8080

# Where the SPA is reachable — the origin invitation links point at. `npm run dev`
# serves it on 5173, and the frontend is deliberately not in compose.
TCMS_BASE_URL=http://localhost:5173

# SMTP. Leave SMTP_HOST empty and no mail is sent: the application logs a warning and
# provision-company still prints the activation link, which is the intended fallback
# rather than a degraded mode. Point it at a local MailPit/Mailhog to see real mail.
SMTP_HOST=
SMTP_PORT=1025
TCMS_MAIL_FROM=tcms@localhost

# Host ports. Change if 5432 or 8080 is already taken locally.
DB_PORT=5432
BACKEND_PORT=8080
