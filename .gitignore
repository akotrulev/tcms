# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
/.idea/

# --- Gradle / backend ---
.gradle/
build/
# The wrapper jar MUST be committed — it is how `./gradlew` bootstraps on a fresh
# clone and in CI. The `*.jar` rule above would otherwise swallow it.
!**/gradle/wrapper/gradle-wrapper.jar

# --- Node / frontend ---
node_modules/
frontend/dist/

# --- Node / packages (the TS client, the CLI, the MCP server) ---
# `packages/*/src/schema.ts` is generated but IS committed, exactly as the SPA's
# `schema.d.ts` is: a fresh clone must typecheck without a network round trip to
# regenerate it, and `schemaFreshness.test.ts` is what keeps it current.
packages/*/dist/
packages/*/node_modules/.tmp/

# --- Local environment ---
# compose reads .env automatically. .env.example is committed and carries the shape;
# the real file is not, so a personal port change or a rotated password never travels.
.env
.env.local
# The second-lane stack's env, same reasoning — its ports are a local arrangement.
.env.lane-b
!.env.example
!.env.lane-b.example

# --- Concurrency worktrees ---
# `git worktree add .claude/worktrees/<name>` puts a whole second checkout inside this one, so
# git offers to commit a checkout into itself. `.claude/settings.json` stays tracked — it is the
# plugin configuration the working agreement depends on; only the worktrees are local.
.claude/worktrees/
