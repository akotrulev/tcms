{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /*
    The two contract checks live under `src` with every other test, but they are not
    application source: it reads the filesystem and runs the TypeScript compiler over
    `src/api/queries`. Typechecking it here would mean adding "node" to `types` above, which
    puts `process`, `Buffer` and `__dirname` in scope for the whole SPA — the same objection
    `vitest.config.ts` records against `globals: true`. It is compiled by `tsconfig.node.json`
    instead, so `npm run build` still covers it.
  */
  "exclude": [
    "src/api/contractParameters.test.ts",
    "src/api/apiResponseTypes.test.ts",
    "src/api/contractOperations.test.ts",
    "src/api/contractIntrospection.ts"
  ]
}
