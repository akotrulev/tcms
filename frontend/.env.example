# Frontend environment — copy to `.env.local` (gitignored) and edit.
#
# Nothing here is required: every value has a working default, and the defaults are the
# no-backend loop. Only `VITE_`-prefixed variables reach the browser, and everything in this
# file is public by construction — never put a secret in it.

# Which API `npm run dev` talks to.
#   mock (default) — MSW serves /api/v1 from src/mocks. No Docker, no Postgres, no company.
#   live           — requests go through the Vite proxy to the real backend. Requires
#                    `docker compose up` and a provisioned company; sign in with a real
#                    invitation-activated account, not "any password of 4+ chars".
VITE_API_MODE=mock

# Where live mode proxies /api. Only read by vite.config.ts, only in dev.
VITE_API_PROXY_TARGET=http://localhost:8080

# Identifies the build a tab is running, for version-skew detection. CI should pass the
# commit SHA; locally a timestamp is generated when this is unset.
# VITE_BUILD_ID=
