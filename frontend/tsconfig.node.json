{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
    `vitest.config.ts` is typechecked here alongside `vite.config.ts` — both are node-side
    config, neither is application source. Leaving it out would mean `npm run build` never
    looks at it, and a broken test config would only surface when someone ran the tests.
  */
  "include": ["vite.config.ts", "vitest.config.ts"]
}
