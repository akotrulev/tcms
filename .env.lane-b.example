# Lane B — a second, fully independent local stack.
#
#   cp .env.lane-b.example .env.lane-b
#   docker compose --env-file .env.lane-b up --build
#
# For when two sessions each need to hold a live browser pass at once. The browser pass is
# otherwise a singleton — one Postgres, one backend, one SPA — and that is what caps
# concurrent work at a single lane no matter how the source files are arranged. See
# docs/plans/2026-07-31-parallel-execution-rework.md.
#
# Everything below differs from .env.example in three ways: the project name, the host
# ports, and the two origins built FROM those ports (the SPA's and the API's). The
# credentials are identical because they are disposable local ones bound to 127.0.0.1 — see
# .env.example for why that is stated rather than assumed.

# The project namespace. This is the load-bearing line: Compose prefixes container AND
# volume names with it, so lane B gets its own `pgdata` instead of migrating lane A's
# database out from under it.
COMPOSE_PROJECT_NAME=tcms-b

# Host ports, all shifted by 1000 so they cannot collide with lane A's.
DB_PORT=6432
BACKEND_PORT=9080
KEYCLOAK_PORT=9081

# Lane B's SPA. Start it with `npm run dev:lane-b` (vite on 6173), or the invitation links
# the CLI prints will send you to lane A's browser tab — pointing at lane A's backend.
TCMS_BASE_URL=http://localhost:6173

# Lane B's own API origin. The redirect_uri an OIDC provider gets registered with is built
# from this, and deploy/keycloak/tcms-realm.json registers both :8080 and :9080 so the same
# export serves both lanes. Get this wrong and the issuer refuses the callback outright.
TCMS_API_BASE_URL=http://localhost:9080

# The hostname is NOT shifted: it is a compose network alias, and each lane has its own
# network, so both projects can carry the same name pointing at their own container. The
# PORT is what separates the two issuers, and it is inside the `iss` claim.
KEYCLOAK_HOSTNAME=keycloak.localtest.me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Identical to .env.example: local, disposable, 127.0.0.1-only. Not a server template.
POSTGRES_SUPERUSER_PASSWORD=local-superuser
DB_MIGRATION_PASSWORD=local-owner
DB_PASSWORD=local-app
TCMS_JWT_SECRET=local-development-signing-key-not-for-any-server
TCMS_INTEGRATION_SECRET_KEY=bG9jYWwtZGV2ZWxvcG1lbnQta2V5LW5vdC1hLXNydnI=
TCMS_IDENTITY_SECRET_KEY=bG9jYWwtZGV2LWlkZW50aXR5LWtleS0zMi1ieXRlcyE=

SMTP_HOST=
SMTP_PORT=1025
TCMS_MAIL_FROM=tcms@localhost
